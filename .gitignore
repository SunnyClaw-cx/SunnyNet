experiments/_gh_poll.py
experiments/_gh_discussion.py
experiments/_find_token.py
experiments/_gh_devcode.py

# 社区/推广草稿 (仅本机, 禁止入库)
docs/COMMUNITY_*.md
docs/DISCUSSIONS_*.md

# 手写内核编译产物 (由 sunnynet.kernels 自动重建)
sunnynet/kernels/_build/
sunnynet/runtime/_build/

# 标量 shim 的编译产物 (由 _run.py 自行重建)
experiments/_avx512_shim/*.dll
experiments/_neon_shim/*.dll
experiments/_avx512_shim/*.so
experiments/_neon_shim/*.so

# 预编译库 (wheel 构建期生成, 不入库)
sunnynet/_prebuilt/

# 外部模型权重 (体积大, 由 download 脚本按需获取)
experiments/gguf/
experiments/ext_models/
experiments/ext_results/

# 第三方参考实现 (仅本地对照用, 版权归原作者)
.ref/
experiments/_ref_*.py

# 构建产物
dist/
build/
*.egg-info/
experiments/*.exe
