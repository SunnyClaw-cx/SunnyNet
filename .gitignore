# 语料与中间产物 (体积大, 由 prepare_data.py / build_corpus.py 重新生成)
data/
runs/

# 实验权重 (由 _ood.py 等脚本重新训练生成)
experiments/ckpts_ood/
experiments/ckpts_100m/
experiments/ckpts_longrecall/
experiments/ckpts_decode/

# 基准输出 (由 experiments 脚本重新生成)
results/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与缓存
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# 实验日志
*.log

# 本机环境探测脚本 (含绝对路径, 无移植价值)
experiments/_*.bat
experiments/_dl_*.sh

# 本地工作记忆 (仅本机, 不入库)
.workbuddy/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
